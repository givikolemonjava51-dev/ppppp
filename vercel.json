{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ka", "destination": "/" },
    { "source": "/ka/pricing", "destination": "/pricing" },
    { "source": "/ka/services", "destination": "/services" },
    { "source": "/ka/about", "destination": "/about" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
